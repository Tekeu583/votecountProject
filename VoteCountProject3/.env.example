APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12
HASHING_DRIVER=bcrypt

# Rate Limiting
RATE_LIMIT_GLOBAL=60,1
RATE_LIMIT_API=100,1
RATE_LIMIT_AUTH=10,1
RATE_LIMIT_VOTE=5,1

# Pagination
PAGINATION_DEFAULT=15
PAGINATION_MAX=100

# Debugbar (développement)
DEBUGBAR_ENABLED=true

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=votecountproject3
DB_USERNAME=postgres
DB_PASSWORD= ton_password

# Cache (Redis)
