APP_NAME=VoteCount
APP_ENV=local

# Publication sans abonnement : true en DEV LOCAL seulement, false en prod.
ALLOW_PUBLISH_WITHOUT_SUBSCRIPTION=false
APP_KEY=base64:4un++82wbMinINOuTRZC+bAdGAddDgsFHqrL4NavkXA=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
# Origine CORS supplementaire (dev local uniquement, vide en prod)
